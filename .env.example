# TemiVault on Creditcoin cc3-testnet. Written automatically by `npm run deploy`.
NEXT_PUBLIC_TEMI_VAULT_ADDRESS=

# TemiSourcePortal on Ethereum Sepolia (Attestcoin chain key 1).
NEXT_PUBLIC_TEMI_SOURCE_PORTAL_ADDRESS=

# Creditcoin proof builder. Override only to point at a self-hosted prover.
NEXT_PUBLIC_ATTESTCOIN_PROVER_URL=https://prover.cc3-testnet.creditcoin.network

# Display-only NGN rate. Never used in on-chain math.
NEXT_PUBLIC_NGN_PER_TCTC=1450
