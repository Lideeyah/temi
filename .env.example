# TemiVault on Creditcoin cc3-testnet. Written automatically by `npm run deploy`.
NEXT_PUBLIC_TEMI_VAULT_ADDRESS=

# TemiSourcePortal on Ethereum Sepolia (Attestcoin chain key 1).
NEXT_PUBLIC_TEMI_SOURCE_PORTAL_ADDRESS=

# Creditcoin proof builder. Override only to point at a self-hosted prover.
NEXT_PUBLIC_ATTESTCOIN_PROVER_URL=https://prover.cc3-testnet.creditcoin.network

# Display-only NGN rate. Never used in on-chain math.
NEXT_PUBLIC_NGN_PER_TCTC=1450

# Gas sponsorship for merchant accounts provisioned by passkey. Without it, a new merchant
# account has no tCTC and cannot transact — the Web3 wallet path still works.
# Use a key funded ONLY for this; it signs drip transactions on a public endpoint.
SPONSOR_PRIVATE_KEY=
SPONSOR_AMOUNT=0.05
SPONSOR_LIFETIME_CAP=5

# Settlement relayer ceilings for the simulated local rails (Trugi / MoMo / M-Pesa).
# Shares SPONSOR_PRIVATE_KEY. Both are per-process guards on a funded testnet key.
RELAYER_MAX_PER_REQUEST=300
RELAYER_LIFETIME_CAP=2000

# Server half of every merchant's key. MUST be set and MUST be stable: change it and every
# merchant's derived vault address changes with it. Belongs in an HSM or KMS in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SERVER_PEPPER=

# Accepts 123456 and returns the code in the response so reviewers can verify ownership without
# SMS credit. Set to false and wire a real gateway before anyone's money depends on it.
OTP_DEMO_MODE=true
